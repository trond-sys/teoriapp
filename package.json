{
  "name": "teori-b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Teori B – trespråklig øvingsapp for teoriprøven klasse B (nb/en/th)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-content": "tsx scripts/validate-content.ts",
    "validate-scenes": "tsx scripts/validate-scenes.ts",
    "audit-scenes": "tsx scripts/audit-scenes.ts",
    "apply-verifications": "tsx scripts/apply-verifications.ts",
    "import-signs": "node scripts/import-signs.mjs && node scripts/write-licenses.mjs",
    "check": "npm run validate-content && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
